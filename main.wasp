app Carvest {
  wasp: {
    version: "^0.23.0"
  },
  title: "Carvest",
  head: [
    "<link rel='icon' href='/favicon.ico' />",
  ],
  client: {
    rootComponent: import Layout from "@src/Layout",
  },
  auth: {
    userEntity: User,
    methods: {
      usernameAndPassword: {}
    },
    onAuthFailedRedirectTo: "/login",
    onAuthSucceededRedirectTo: "/"
  }
}

route LoginRoute { path: "/login", to: LoginPage }
page LoginPage {
  component: import Login from "@src/pages/auth/Login"
}
route SignupRoute { path: "/signup", to: SignupPage }
page SignupPage {
  component: import Signup from "@src/pages/auth/Signup"
}

action claimDailyCheckin {
  fn: import { claimDailyCheckin } from "@src/server/actions",
  entities: [User, Settings]
}

action createInvestment {
  fn: import { createInvestment } from "@src/server/actions",
  entities: [User, InvestmentPlan, Investment]
}

action requestDeposit {
  fn: import { requestDeposit } from "@src/server/actions",
  entities: [Transaction, DepositMethod, Settings, User]
}

action requestWithdrawal {
  fn: import { requestWithdrawal } from "@src/server/actions",
  entities: [Transaction, Settings, User, Investment]
}

action updateBankDetails {
  fn: import { updateBankDetails } from "@src/server/actions",
  entities: [UserBank, User]
}

action completeOnboarding {
  fn: import { completeOnboarding } from "@src/server/actions",
  entities: [User, Referral, Settings]
}

action adminApproveDeposit {
  fn: import { adminApproveDeposit } from "@src/server/actions",
  entities: [Transaction, User, Referral, Settings]
}

action adminRejectDeposit {
  fn: import { adminRejectDeposit } from "@src/server/actions",
  entities: [Transaction]
}

action adminApproveWithdrawal {
  fn: import { adminApproveWithdrawal } from "@src/server/actions",
  entities: [Transaction, User]
}

action adminRejectWithdrawal {
  fn: import { adminRejectWithdrawal } from "@src/server/actions",
  entities: [Transaction]
}

action adminCreatePlan {
  fn: import { adminCreatePlan } from "@src/server/actions",
  entities: [InvestmentPlan]
}

action adminUpdatePlan {
  fn: import { adminUpdatePlan } from "@src/server/actions",
  entities: [InvestmentPlan]
}

action adminTogglePlanActive {
  fn: import { adminTogglePlanActive } from "@src/server/actions",
  entities: [InvestmentPlan]
}

action adminDeletePlan {
  fn: import { adminDeletePlan } from "@src/server/actions",
  entities: [InvestmentPlan, Investment]
}

action adminMarkInvestmentMatured {
  fn: import { adminMarkInvestmentMatured } from "@src/server/actions",
  entities: [Investment, User]
}

action adminCancelInvestment {
  fn: import { adminCancelInvestment } from "@src/server/actions",
  entities: [Investment, User]
}

action adminUpdateDepositMethod {
  fn: import { adminUpdateDepositMethod } from "@src/server/actions",
  entities: [DepositMethod]
}

action adminUpdateSettings {
  fn: import { adminUpdateSettings } from "@src/server/actions",
  entities: [Settings]
}

action adminUpdateUser {
  fn: import { adminUpdateUser } from "@src/server/actions",
  entities: [User, Transaction]
}

query getDashboardData {
  fn: import { getDashboardData } from "@src/server/queries",
  entities: [User, Investment]
}

query getInvestmentPlans {
  fn: import { getInvestmentPlans } from "@src/server/queries",
  entities: [InvestmentPlan]
}

query getMyInvestments {
  fn: import { getMyInvestments } from "@src/server/queries",
  entities: [Investment, User]
}

query getProfileData {
  fn: import { getProfileData } from "@src/server/queries",
  entities: [User, Referral, UserBank]
}

query getTransactions {
  fn: import { getTransactions } from "@src/server/queries",
  entities: [Transaction, User]
}

query getDepositMethods {
  fn: import { getDepositMethods } from "@src/server/queries",
  entities: [DepositMethod]
}

query getSettingsPublic {
  fn: import { getSettingsPublic } from "@src/server/queries",
  entities: [Settings]
}

query adminGetDashboardStats {
  fn: import { adminGetDashboardStats } from "@src/server/queries",
  entities: [User, Transaction, Investment]
}

query adminGetPendingDeposits {
  fn: import { adminGetPendingDeposits } from "@src/server/queries",
  entities: [Transaction, User]
}

query adminGetUsers {
  fn: import { adminGetUsers } from "@src/server/queries",
  entities: [User]
}

query adminGetUserDetails {
  fn: import { adminGetUserDetails } from "@src/server/queries",
  entities: [User, UserBank, Investment, Transaction]
}

query adminGetInvestments {
  fn: import { adminGetInvestments } from "@src/server/queries",
  entities: [Investment, InvestmentPlan, User]
}

query adminGetSettings {
  fn: import { adminGetSettings } from "@src/server/queries",
  entities: [Settings]
}

query adminGetDepositMethods {
  fn: import { adminGetDepositMethods } from "@src/server/queries",
  entities: [DepositMethod]
}

route HomeRoute { path: "/", to: HomePage }
page HomePage {
  component: import HomePage from "@src/pages/Home.tsx",
  authRequired: true
}

route InvestmentsRoute { path: "/investments", to: InvestmentsPage }
page InvestmentsPage {
  component: import InvestmentsPage from "@src/pages/Investments.tsx",
  authRequired: true
}

route ProfileRoute { path: "/profile", to: ProfilePage }
page ProfilePage {
  component: import ProfilePage from "@src/pages/Profile.tsx",
  authRequired: true
}

route DepositRoute { path: "/deposit", to: DepositPage }
page DepositPage {
  component: import DepositPage from "@src/pages/Deposit.tsx",
  authRequired: true
}

route WithdrawRoute { path: "/withdraw", to: WithdrawPage }
page WithdrawPage {
  component: import WithdrawPage from "@src/pages/Withdraw.tsx",
  authRequired: true
}


route AdminPanelRoute { path: "/admin9090", to: AdminPanelPage }
page AdminPanelPage {
  component: import AdminPanelPage from "@src/pages/admin/AdminPanel.tsx",
  authRequired: true
}
